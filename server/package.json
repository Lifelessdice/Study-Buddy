{
  "name": "server",
  "version": "0.1.0",
  "engines": {
    "node": "22.x"
  },
  "private": true,
  "description": "Template for ExpressJS API with Mongoose for Web and Mobile Engineering (DIT342)",
  "main": "./app.js",
  "scripts": {
    "start": "node ./server.js",
    "dev": "nodemon ./server.js",
    "lint": "eslint .",
    "test": "cross-env MONGODB_URI=mongodb://localhost:27017/serverTestDB npm run newman-server",
    "ci-test": "npm run newman-server",
    "newman-server": "cross-env PORT=3001 npm-run-all dropdb --parallel --race start newman-wait",
    "newman-wait": "wait-on http://localhost:3001/api && npm run newman",
    "newman": "newman run ./tests/server.postman_collection.json --env-var baseUrl=http://localhost:3001/api/v1 --reporters cli,junit --reporter-junit-export ../newman-results.xml",
    "dropdb": "node ./tests/dropdb.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/dit342/group-00-web.git"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.2",
    "connect-history-api-fallback": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.4",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.9.1",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.47.0",
    "newman": "^6.2.1",
    "nodemon": "^3.1.11",
    "npm-run-all": "^4.1.5",
    "wait-on": "^8.0.0"
  }
}
